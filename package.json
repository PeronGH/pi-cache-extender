{
	"name": "pi-cache-extender",
	"version": "0.1.0",
	"description": "Extends Anthropic prompt cache lifetime using a 2-point return curve and zero-output refresh pings",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-coding-agent",
		"pi-extension"
	],
	"repository": "https://github.com/PeronGH/pi-cache-extender",
	"files": [
		"extensions",
		"src",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"scripts": {
		"check": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"verify": "bun run check && bun run typecheck && bun test"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@earendil-works/pi-ai": "^1.5.2",
		"@earendil-works/pi-coding-agent": "^1.5.2",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
